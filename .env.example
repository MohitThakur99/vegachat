# Optional. `docker compose up` works with no .env at all, using the bundled
# Postgres container. Copy this to .env only to change something below.

# --- Use Supabase instead of the bundled Postgres ---------------------------
# Supabase dashboard -> Connect -> "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

# --- Secrets and origins -----------------------------------------------------
# At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_ACCESS_SECRET=

# Where the browser loads the app from. Change it if you open the app through
# another host name or port than http://localhost:8080.
# CLIENT_ORIGIN=http://localhost:8080

# Set to true when the app is served over https.
# COOKIE_SECURE=false
