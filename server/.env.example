# Copy to .env for local development (npm run dev).

NODE_ENV=development
PORT=4000

# `docker compose up db` publishes Postgres on 5433 so it cannot clash with a
# local install on 5432. For Supabase, paste the connection string here and set
# DATABASE_SSL=true.
DATABASE_URL=postgres://vegachat:vegachat@localhost:5433/vegachat
DATABASE_SSL=false

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of origins the browser app is served from.
CLIENT_ORIGIN=http://localhost:5173

# Use COOKIE_SECURE=true behind HTTPS. Use COOKIE_SAMESITE=none (with
# COOKIE_SECURE=true) only when the client and the API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the server (0 when run directly).
TRUST_PROXY=0

UPLOAD_DIR=./uploads

# Insert the demo data on boot when the database has no users.
SEED_ON_START=true
